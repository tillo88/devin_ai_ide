{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEVIN AI IDE",
  "version": "0.1.0",
  "identifier": "local.devin.aiide",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DEVIN AI IDE",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Client Windows per il workspace DEVIN sul rig.",
    "longDescription": "DEVIN AI IDE e' un thin client Windows. Backend, workspace, training e modelli restano sul rig.",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "DEVIN"
      }
    }
  }
}
